# ============================================================================
# BackPOS — Retail Store POS & Inventory Management System
# ALL connection details, secrets and tunable business rules live here.
# Copy this file to `.env` and edit. (.env is git-ignored)
# ============================================================================

# ---------------------------------------------------------------- Server bind
APP_HOST=0.0.0.0
APP_PORT=8080
# Public base URL of the API (used in logs/everywhere a URL is needed)
BASE_URL=http://127.0.0.1:8080
# Comma-separated browser origins allowed by CORS ("*" = allow all, dev only)
CORS_ORIGINS=*

# ------------------------------------------------------------------- Database
MYSQL_URI=mysql://root:SHOWYOUROWN@127.0.0.1:3306
MYSQL_DATABASE=retail_pos
MYSQL_MAX_CONNECTIONS=10
MYSQL_MIN_CONNECTIONS=2
MYSQL_ACQUIRE_TIMEOUT_SECS=10

# ------------------------------------------------------------------ Security
JWT_SECRET=replace-with-64-chars-of-random-hex-please-change-me-0123456789abcdef
ACCESS_TOKEN_TTL_HOURS=12
REFRESH_TOKEN_TTL_DAYS=30
# Bcrypt hashing cost (10 = dev, 12 = production)
BCRYPT_COST=10

# -------------------------------------------------- Bootstrap admin + store
# Created automatically on first boot if missing.
ADMIN_NAME="System Administrator"
ADMIN_EMAIL=admin@backpos.local
ADMIN_PASSWORD=admin-12345678
ADMIN_PIN=9911
STORE_CODE=HQ
STORE_NAME="BackPOS HQ Store"
STORE_ADDRESS="123 Main Street, Springfield"
STORE_PHONE=555-0100
# Second, online storefront; set CREATE_ONLINE_STORE=true to seed it.
CREATE_ONLINE_STORE=true

# ------------------------------------------------------ Business rules (tune)
STORE_CURRENCY=USD
DEFAULT_TAX_RATE=8.00
RECEIPT_PREFIX=RCP
PO_NUMBER_PREFIX=PO
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100
# Low-stock alert is raised when total stock across stores falls at/below this
# margin under the product's own reorder threshold.
LOW_STOCK_ALERT_ENABLED=true
# Auto-draft purchase orders grouped per supplier when a product hits low stock.
AUTO_DRAFT_PO_ENABLED=true
# Loyalty points earned per unit of currency spent (integer points are credited).
LOYALTY_EARN_RATE=1.0

# ------------------------------------------------------------------- Logging
RUST_LOG=info
